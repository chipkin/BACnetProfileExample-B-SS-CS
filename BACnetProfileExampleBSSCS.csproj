<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build:
      dotnet build -c Release
    Run (from the example folder, after the native library is next to the
    build output - see README.md "Build the native CAS BACnet Stack library"):
      dotnet run -c Release [double-dash] port 47821

    Why Release only: the stack's C# adapter's DllImport filename is
    "CASBACnetStack_x64_Debug" under #if DEBUG, else "CASBACnetStack_x64_Release"
    (see common's note in CASExampleHelper.cs and README.md). The stack's only
    build is CMake (submodules/cas-bacnet-stack/CMakePresets.json); its DLL
    presets (windows-x64-dll-release, linux-x64-release-shared) build only the
    Release library, CASBACnetStack_x64_Release.dll /
    libCASBACnetStack_x64_Release.so, and the items below copy only those
    names. So this example is built and run in Release; a Debug build will
    start but fail to load the native library.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BACnetProfileExampleBSSCS</AssemblyName>
    <Version>1.2.0</Version>
    <RootNamespace>BACnetProfileExampleBSSCS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The default SDK-style glob (**/*.cs) would otherwise also pick up the whole
         submodules/cas-bacnet-stack tree - including its own selftest/Program.cs (a second
         top-level-statements entry point) and unrelated adapters for other languages'
         selftests. Exclude the submodule tree from the default items, then explicitly
         include only the three C# adapter files this project actually needs, below. -->
    <Compile Remove="submodules/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CAS BACnet Stack's generated C# adapter, compiled IN PLACE from the submodule
         (never copied into this repository) - direct source inclusion is
         the established pattern for this adapter (there is no NuGet package);
         see submodules/cas-bacnet-stack/adapters/csharp/selftest/PropertyBufferHelperSelfTest.csproj
         for the precedent this follows. PropertyBufferHelper.cs is included
         for parity with the adapter's expected 3-file set even though this
         read-only B-SS example never calls a buffer-shaped Send* function
         (ReadProperty/WriteProperty/CreateObject as a client) - see README.md
         "Why PropertyBufferHelper.cs is here but unused". -->
    <Compile Include="submodules/cas-bacnet-stack/adapters/csharp/CASBACnetStackAdapter.cs" />
    <Compile Include="submodules/cas-bacnet-stack/adapters/csharp/CASBACnetStackAdapterBindings.cs" />
    <Compile Include="submodules/cas-bacnet-stack/adapters/csharp/PropertyBufferHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native CAS BACnet Stack library the adapter P/Invokes, copied next to the build
         output when it has been built (README "Build the native CAS BACnet Stack library":
         the stack's CMake DLL preset, then "cmake [double-dash]install build-<preset>", writes it to the
         submodule's bin/). Absent = nothing copied. The copy lands only in the gitignored
         build output (bin/); the stack binary is never committed or released. -->
    <None Include="submodules/cas-bacnet-stack/bin/CASBACnetStack_x64_Release.dll"
          Condition="Exists('submodules/cas-bacnet-stack/bin/CASBACnetStack_x64_Release.dll')"
          Link="CASBACnetStack_x64_Release.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
    <None Include="submodules/cas-bacnet-stack/bin/libCASBACnetStack_x64_Release.so"
          Condition="Exists('submodules/cas-bacnet-stack/bin/libCASBACnetStack_x64_Release.so')"
          Link="libCASBACnetStack_x64_Release.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Visible="false" />
  </ItemGroup>

</Project>
